<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LittleHero</AssemblyName>
    <RootNamespace>LittleHero</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Level maps are plain-text files that must sit next to the executable -->
    <None Update="Level*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
